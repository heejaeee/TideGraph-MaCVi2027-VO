+        # earlier outputs are detached copies. Keep the emitted prefix in the
+        # same coordinate units (pose encoding translation scales linearly).
+        correction = predictions.get("metric_scale_correction")
+        if correction is not None:
+            for previous in predictions_list:
+                for name in ("pose_enc", "depth"):
+                    if isinstance(previous.get(name), torch.Tensor):
+                        value = previous[name].clone()
+                        if name == "pose_enc":
+                            value[..., :3] *= float(correction)
+                        else:
+                            value *= float(correction)
+                        previous[name] = value
